# =============================================================================
#  EDUSKILL INDIA FOUNDATION — Apache configuration
# =============================================================================
#  Works on Apache shared hosting with mod_rewrite. If the site is installed at
#  a different path, update RewriteBase below.
# =============================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.php

# -----------------------------------------------------------------------------
# No trailing path segments after a script name.
#
# By default Apache truncates the path at the deepest component that exists and
# hands the remainder to the script as PATH_INFO, so /about.php/junk returned 200
# and served the real About page — as did /index.php/junk, /contact.php/a/b/c and
# every other page, at unlimited distinct URLs. That is duplicate content, an
# unbounded cache-key surface, and it is the same truncation that turned the
# clean-URL guard below into a 10-redirect 500 (see the note there).
#
# Safe to switch off here: nothing in this codebase reads PATH_INFO or
# ORIG_PATH_INFO (grep -rn PATH_INFO over *.php returns nothing), and no rewrite
# rule feeds path segments to a script — email-track.php and document.php both
# take ordinary query parameters. Every pretty URL goes through an explicit
# RewriteRule instead.
# -----------------------------------------------------------------------------
AcceptPathInfo Off

# -----------------------------------------------------------------------------
# Never serve developer/config files that live in the web root.
# README.md, INSTALL.md and TESTING.md are unlinked but were fetchable with a
# plain GET — INSTALL.md documents the deployment layout and DB setup steps.
# Handled with FilesMatch (not a RewriteRule) so it still applies on hosts where
# mod_rewrite is unavailable.
# -----------------------------------------------------------------------------
<FilesMatch "\.(md|markdown|sql|log|ini|yml|yaml|lock|json|dist|bak|old|orig|save|swp|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# The config files, denied in the AUTHZ phase.
#
# There is already a "RewriteRule ^config\.php$ - [F,L]" below, and it does not
# work: mod_rewrite's per-directory ruleset runs in the fixup phase, and for any
# path ending in .php the clean-URL redirect further down matched first, so
# /config.php answered 301 -> /config instead of 403. The request still ended on
# the 404 page and no credentials were ever served, but the rule everyone would
# point at as "the protection" was not the thing doing the protecting.
#
# <Files> is evaluated during authorization, before mod_rewrite gets the
# request, so it cannot be outrun by rule ordering. Verified: 403, zero bytes.
# -----------------------------------------------------------------------------
<FilesMatch "^config(\.example|\.production)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# Deployment archives. eduskill-hostinger-deploy.zip is a BUILD ARTEFACT that
# contains the whole source tree INCLUDING config.php — i.e. the live DB
# credentials and the AES-256 key — and .zip was not covered by the deny list
# above, so a plain GET on the artefact's well-known name handed over every
# secret in the install. Archives are never a served content type here.
# -----------------------------------------------------------------------------
<FilesMatch "\.(zip|tar|gz|tgz|bz2|xz|7z|rar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# Underscore-prefixed files are the project's convention for local probes,
# previews and diagnostics (_diag.php, _dochub_preview.html, and the throwaway
# _*_probe.php harnesses that audits keep leaving behind). They are not part of
# the application and several have shipped with NO authentication while calling
# card renderers that print a member's email, mobile and address. Denying the
# whole prefix means the next one is dead on arrival instead of relying on
# somebody remembering to delete it.
#
# NOTE: this also disables _diag.php. That is intentional — run it by renaming
# it temporarily, then delete it; a permanently reachable diagnostic endpoint is
# exactly the class of file this rule exists to stop.
# -----------------------------------------------------------------------------
<FilesMatch "^_">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# manifest.php serves the PWA manifest through a rewrite, so the .json deny
# above must not apply to a real manifest file if one is ever generated.
<Files "manifest.webmanifest">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------------------------
    # NO RewriteBase — deliberately.
    #
    # This used to read "RewriteBase /pwf/", the local XAMPP subfolder, with a
    # comment telling you to change it to "/" for a domain root. That comment is
    # not a mechanism: this file is committed to Git, and a Git-based deploy put
    # the DEV value on production, where every relative substitution below then
    # resolved to /pwf/about.php and 404'd. The live site broke exactly this way.
    #
    # In a .htaccess, mod_rewrite already resolves a relative substitution
    # against the directory this file sits in. RewriteBase is only needed when
    # the URL path and the filesystem path diverge (an Alias, a symlink) — which
    # is not the case here, in either environment. Omitting it makes ONE file
    # correct at a subfolder AND at a domain root, with nothing to remember.
    #
    # The one rule that cannot be relative is the .php -> clean-URL redirect
    # below; it captures the full path from THE_REQUEST and substitutes /%1,
    # which is already environment-independent.
    # -------------------------------------------------------------------------

    # -------------------------------------------------------------------------
    # Reject TRACK and other non-standard methods here. NOTE: real TRACE cannot
    # be blocked from .htaccess — Apache's core answers TRACE before mod_rewrite
    # runs — so it is disabled with "TraceEnable off" in httpd.conf (applied at
    # server level; see the VAPT report's production checklist).
    # -------------------------------------------------------------------------
    RewriteCond %{REQUEST_METHOD} ^(TRACK|DEBUG)$ [NC]
    RewriteRule ^ - [F]

    # -------------------------------------------------------------------------
    # Force HTTPS (uncomment on production once an SSL certificate is active)
    # -------------------------------------------------------------------------
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # -------------------------------------------------------------------------
    # Block direct access to sensitive folders/files
    # -------------------------------------------------------------------------
    RewriteRule ^(includes|database|logs|docs)/ - [F,L]
    RewriteRule ^config\.php$ - [F,L]

    # Block the Git metadata folder (present in the webroot when the site is
    # deployed via Hostinger's GIT feature). The dotfile <FilesMatch "^\."> below
    # does NOT cover .git/config etc., because that file's basename is "config".
    RewriteRule (^|/)\.(git|github)(/|$) - [F,L]

    # Dynamic XML sitemap (only when no static sitemap.xml has been generated)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # PWA manifest
    RewriteRule ^manifest\.webmanifest$ manifest.php [L]

    # Pretty content URLs (optional): /blog/slug, /program/slug, etc.
    RewriteRule ^blog/([A-Za-z0-9\-]+)/?$ blog-details.php?slug=$1 [L,QSA]
    RewriteRule ^program/([A-Za-z0-9\-]+)/?$ programs.php?slug=$1 [L,QSA]
    RewriteRule ^event/([A-Za-z0-9\-]+)/?$ events.php?slug=$1 [L,QSA]
    RewriteRule ^campaign/([A-Za-z0-9\-]+)/?$ campaigns.php?slug=$1 [L,QSA]
    RewriteRule ^scheme/([A-Za-z0-9\-]+)/?$ schemes.php?slug=$1 [L,QSA]

    # Human-readable membership verification: /verify/member/EIF-2026-00042.
    # This is the route a person TYPES from the printed card, and every printed
    # card PRINTS this path as text — the URL shape is public and permanent, so
    # it must keep resolving even if verify-member.php is renamed. The QR code
    # does NOT encode it: the QR carries the opaque qr_token, because a code URL
    # is the one enumerable surface. The code path is rate-limited inside
    # verify-member.php on its own counter. The character class must keep hyphens
    # (member_generate_code() emits PREFIX-YEAR-NNNNN) and is bounded to 32
    # characters, which is the width of the members.member_code column and of
    # the form's own maxlength — a 4000-character "code" has nothing to match.
    #
    # NOT [QSA]: the query string is merged BEFORE ?code=, so the captured path
    # segment is the LAST occurrence and PHP's last-wins parsing makes it the
    # value that arrives. With [QSA] the original query was appended AFTER ours,
    # so /verify/member/X?code=<anything> silently overrode the capture and the
    # character class stopped being binding. Any real ?token= / ?utm_* still
    # rides along; an empty query yields "?&code=…", which PHP parses fine.
    RewriteRule ^verify/member/([A-Za-z0-9\-]{1,32})/?$ verify-member.php?%{QUERY_STRING}&code=$1 [L]

    # -------------------------------------------------------------------------
    # Contextual login portals:  /login/{role}  ->  login.php?portal={role}
    # One login page serves every audience and branches on ?portal=, so each
    # portal gets its own shareable URL without a separate PHP file per role.
    #
    # The roles are an EXPLICIT whitelist, never a (.+) capture, so the set of
    # URLs that exist is a closed list and an unlisted role 404s. Note what the
    # whitelist does and does not do: it constrains the PATH, and — because the
    # query string is merged BEFORE ?portal= rather than with [QSA] — it now also
    # constrains the VALUE that reaches PHP, since PHP takes the last occurrence
    # of a repeated parameter. It is still not an output filter: whatever a page
    # echoes must go through e() regardless. [NC] so a capitalised link in print
    # or in an email ("/login/Member") reaches the portal instead of the 404;
    # login.php is noindex,nofollow, so the case variants cost no duplicate
    # content.
    #
    # /login/admin is listed FIRST and points at admin/login.php on purpose: the
    # admin panel is a separate auth realm with its own session, and must never
    # be served by the member login form. Its OTHER defences (admin_ip_whitelist,
    # force_2fa) ship default-off and are OFF in this install — the door is a
    # password form with a 5-per-15-min lockout and a math CAPTCHA after 3 fails.
    # So this alias is deliberately kept out of the crawl: robots.txt disallows
    # /login/admin and the portal card links it rel="nofollow". Turn on the IP
    # allow-list and force_2fa in Security Center before treating it as hardened.
    # The ?portal= is inert for admin/login.php today — it reads no GET input.
    # -------------------------------------------------------------------------
    RewriteRule ^login/admin/?$ admin/login.php?%{QUERY_STRING}&portal=admin [L,NC]
    RewriteRule ^login/(staff|school|teacher|student|volunteer|member|donor)/?$ login.php?%{QUERY_STRING}&portal=$1 [L,NC]

    # -------------------------------------------------------------------------
    # Clean URLs: /about  ->  /about.php  (only if the .php file exists)
    #
    # The guard tests DOCUMENT_ROOT + the base + the captured path, NOT
    # %{REQUEST_FILENAME}. Apache truncates REQUEST_FILENAME at the deepest path
    # component that exists and moves the rest into PATH_INFO, so for
    # /about/nonsense it is ".../pwf/about" and "%{REQUEST_FILENAME}\.php -f"
    # was satisfied by about.php. The rule then appended .php to the FULL URI
    # ("about/nonsense.php"), which truncated the same way, appended again, and
    # hit AH00124 "exceeded the limit of 10 internal redirects" — a 500 on
    # /about/x, /contact/x, /login/x and every other page + garbage segment.
    # Testing the whole path makes those a clean 404. $1 (not %{REQUEST_URI})
    # so a trailing slash, which the rule pattern strips, still resolves.
    #
    # PORTABILITY: tested BOTH with and without the /pwf/ prefix, so one file
    # works at a subdirectory install AND at a domain root. A single hardcoded
    # "/pwf/" here would have been a silent site-down on deploy: production sets
    # BASE_URI='' (config.php:79 note, DEPLOY_HOSTINGER_GIT.md:134), so
    # DOCUMENT_ROOT/pwf/ would not exist, the condition would never match, and
    # EVERY extensionless URL on the live site would 404 while local stayed green.
    # -------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/pwf/$1.php -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    # Redirect requests that explicitly include .php to the clean URL.
    # %1 is captured from THE_REQUEST, so it is the FULL path from the server
    # root (e.g. "pwf/about" on a subfolder install, "about" at a domain root).
    # It must be substituted with a leading slash: a relative substitution is
    # resolved against RewriteBase and would yield /pwf/pwf/about -> 404.
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # -------------------------------------------------------------------------
    # Portable custom 404. Must stay LAST — everything above it either matched
    # and stopped, or named a real file.
    #
    # ErrorDocument (below) needs an absolute path from the SERVER root, so its
    # value necessarily differs between a subfolder install (/pwf/404.php) and a
    # domain root (/404.php). There is no way to write one value that is correct
    # in both, and the committed file has to hold one of them — which is how the
    # live site ended up with ErrorDocument pointing at a path that does not
    # exist there, so Apache served its own default error page instead.
    #
    # This rule is a RELATIVE substitution, so it resolves against whichever
    # directory this file sits in and is correct in both environments. 404.php
    # sets its own 404 status, so the response code stays honest.
    # -------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

# -----------------------------------------------------------------------------
# Custom error pages
#
# These cover the errors Apache raises BEFORE mod_rewrite runs (a 403 from an
# authz deny, a 500 from a PHP fatal), which the relative rewrite above cannot
# reach.
#
# The paths are written for a DOMAIN-ROOT install, because that is where the
# live site runs and where getting this wrong actually costs something: with a
# broken ErrorDocument, a 500 falls back to Apache's own page, which names
# postmaster@localhost and leaks the server signature.
#
# On a subfolder install (XAMPP at /pwf) these point at files that are not
# there, so 403 and 500 show the plain server page locally. Normal 404s are
# unaffected in both — the relative rewrite above handles those.
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
# 500.php renders in two tiers and falls back to a fully self-contained page if
# bootstrap itself throws, so it is safe as an error document for a 500 — without
# this line a server error served Apache's default page, which names
# "postmaster@localhost" and leaks the server signature.
ErrorDocument 500 /500.php

# -----------------------------------------------------------------------------
# Block dotfiles (.env, .git, .htaccess, etc.)
# -----------------------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Extra guard for config in case mod_rewrite is unavailable
<Files "config.php">
    Require all denied
</Files>

# -----------------------------------------------------------------------------
# Security response headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # The campaign embed widget is INTENTIONALLY frame-able by third-party
    # sites — exempt it from the anti-framing headers (PHP header_remove()
    # cannot undo "Header always set", and "Header set" would clobber the
    # page's own frame-ancestors CSP).
    SetEnvIf Request_URI "/campaign-embed" PWF_EMBED_OK
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN" env=!PWF_EMBED_OK
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS — only emitted over HTTPS (a browser ignores it on plain HTTP, and
    # sending it during local HTTP dev would be wrong). Once the site is served
    # over TLS this pins clients to HTTPS for a year, including subdomains.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    # Content-Security-Policy is intentionally permissive for the CDN scripts
    # (Chart.js, SweetAlert2, Lucide, CKEditor) used in the admin panel. Tighten for production.
    # Razorpay is the only gateway that runs IN the browser (donate-pay.php:148
    # loads checkout.razorpay.com and the modal opens an api.razorpay.com iframe).
    # Without these three entries the donation checkout is blocked by our own CSP.
    # Cashfree/Stripe/PayPal are server-side redirects and need no CSP entry.
    # frame-src also needs 'self' for the admin Theme Settings live preview iframe.
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.ckeditor.com https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://www.clarity.ms https://static.hotjar.com https://script.hotjar.com https://checkout.razorpay.com https://translate.google.com https://translate.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.ckeditor.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdn.ckeditor.com data:; connect-src 'self' https://cdn.ckeditor.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://connect.facebook.net https://*.clarity.ms https://*.hotjar.com wss://*.hotjar.com https://api.razorpay.com https://lumberjack.razorpay.com https://translate.googleapis.com https://translate-pa.googleapis.com; frame-src 'self' https://www.google.com https://www.youtube.com https://www.googletagmanager.com https://*.hotjar.com https://api.razorpay.com https://checkout.razorpay.com https://translate.google.com;" env=!PWF_EMBED_OK
</IfModule>

# -----------------------------------------------------------------------------
# Gzip / Deflate compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Browser caching
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType image/jpeg              "access plus 6 months"
    ExpiresByType image/png               "access plus 6 months"
    ExpiresByType image/webp              "access plus 6 months"
    ExpiresByType image/svg+xml           "access plus 6 months"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# -----------------------------------------------------------------------------
# Upload limits (mod_php only)
# -----------------------------------------------------------------------------
# The companion to /.user.ini, which covers the PHP-FPM/CGI case. Exactly one of
# the two applies on any given server and the other is ignored, so both are
# needed to make the limits reliable wherever this is deployed:
#
#   Apache + mod_php  -> .htaccess php_value works, .user.ini is ignored
#   PHP-FPM / CGI     -> .user.ini works, php_value here is ignored
#
# The IfModule guard matters. php_value outside it is a FATAL Apache error on a
# server without mod_php ("Invalid command 'php_value'"), which takes the whole
# site down with a 500 rather than merely failing to set the value.
#
# Why these numbers: the site was running the stock 2M/8M defaults while
# /coordinator-apply invited ten documents of up to 5 MB, so ordinary phone
# photographs were rejected and a few documents together pushed the request past
# post_max_size — where PHP silently discards the entire body and the applicant
# is told every field they filled in was empty. See includes/upload.php.
#
# Keep post_max_size at or below the reverse proxy's client_max_body_size, or
# nginx rejects the request with its own 413 before PHP ever sees it.
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 48M
    php_value max_file_uploads 30
    php_value max_input_time 120
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 48M
    php_value max_file_uploads 30
    php_value max_input_time 120
</IfModule>

# -----------------------------------------------------------------------------
# UTF-8 default
# -----------------------------------------------------------------------------
AddDefaultCharset UTF-8
