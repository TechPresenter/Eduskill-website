# =============================================================================
#  Line endings & diff behaviour
#  Normalise text to LF in the repository so the tree is identical whether it
#  was authored on Windows (XAMPP) or checked out on a Linux host (cPanel /
#  Hostinger / LiteSpeed). Working copies keep their platform-native endings.
# =============================================================================

* text=auto eol=lf

# Server-side files that MUST be LF (shell/cron/Apache choke on CRLF).
*.php     text eol=lf
*.sql     text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf
.htaccess text eol=lf

# Binary — never munge, never diff as text.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.zip     binary
*.mp4     binary

# Keep GitHub's language stats focused on first-party code.
includes/lib/**   linguist-vendored
assets/vendor/**  linguist-vendored
database/*.sql    linguist-generated
