# =============================================================================
#  Uploads hardening — serve files, but NEVER execute scripts here.
# =============================================================================
# Disable script engines inside the uploads directory.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Refuse to hand back any server-side script even if the engine is on.
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
AddType text/plain .php .phtml

# Defense-in-depth for SVG: even a sanitiser-bypassing SVG must not execute as a
# top-level document. Force it to download and forbid all script via CSP, so a
# stored SVG can never run JavaScript in this origin.
<FilesMatch "\.svg$">
    <IfModule mod_headers.c>
        Header set Content-Disposition "attachment"
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
