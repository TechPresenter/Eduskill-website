# =============================================================================
#  Applicant résumés — never served directly over the web.
# =============================================================================
#  These are job / internship / volunteer application CVs: names, phone numbers,
#  addresses and employment history. Apache used to hand them to any anonymous
#  request that knew the filename.
#
#  They are now streamed by admin/secure-file.php, which enforces
#  require_admin() first. Nothing should link here directly — use
#  secure_upload_url() (includes/helper.php), not upload_url().
# =============================================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
