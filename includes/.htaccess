# No direct web access. These files are the app's server-side library, loaded by the page scripts
# (index.php, admin/*, api/*) — never requested directly by a browser.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
