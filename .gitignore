# =============================================================================
#  EDUSKILL INDIA FOUNDATION — .gitignore
#  Anything pushed to GitHub must be treated as permanently public, even if
#  deleted later. Secrets, runtime state and user data stay out of the repo.
# =============================================================================

# ── Secrets ──────────────────────────────────────────────────────────────────
# Live credentials + the AES-256 encryption key live here.
# Cloners copy config.example.php -> config.php and fill it in.
/config.php
.env
.env.*
!.env.example

# ── Runtime user uploads ─────────────────────────────────────────────────────
# Keep the directory tree (the app writes into it) and the .htaccess guard that
# disables script execution — but never commit visitor-submitted files.
/uploads/**
!/uploads/**/
!/uploads/.htaccess
!/uploads/**/.gitkeep

# ── Runtime storage: backups, caches, pre-rebrand file snapshots ─────────────
# storage/rebrand-backup/ contains an old copy of config.php WITH the live key.
/storage/*
!/storage/.htaccess
!/storage/.gitkeep

# ── Logs ─────────────────────────────────────────────────────────────────────
/logs/*
!/logs/.htaccess
!/logs/.gitkeep
*.log

# ── Database dumps (schema/seed .sql ARE committed; dumps are not) ───────────
/database/backups/
*.sql.gz
*.dump
dump.sql
backup*.sql

# Combined production dump: carries real site content and the admin bcrypt hash.
# Built locally with the generator, transferred to the host by phpMyAdmin/SFTP —
# never through a public repo.
/database/eduskill.sql

# ── Deployment artefacts ─────────────────────────────────────────────────────
# Build-output archives uploaded straight to the host; not source.
/eduskill-hostinger-deploy.zip
*.zip

# ── Local preview / scratch artefacts ────────────────────────────────────────
# The pattern is the whole underscore PREFIX, not "-preview" suffixes: audit
# harnesses have been left in the web root as _geo_probe.php and
# _card_audit_tmp.php, which matched none of the old patterns, showed as "??" in
# git status, and would have been published by a single `git add -A` — one of
# them an unauthenticated ?id= card renderer that printed member PII.
/_*.php
/_*.html
/_*.pdf
/_*.png
/_*.zip
/tmp/
/temp/

# ── Editor & OS cruft ────────────────────────────────────────────────────────
*.bak
*.orig
*.rej
*~
*.swp
*.swo
*.pre-*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
.DS_Store
.AppleDouble
.vscode/
.idea/
*.sublime-workspace
*.code-workspace

# ── Dependency dirs (project is Composer-free / Node-free by design) ─────────
node_modules/
vendor/composer/

# Temporary deployment diagnostic (upload to host, delete after use)
/_diag.php

# Build artefact: the safe UPDATE script for the live database.
/database/eduskill-update.sql

# Production config carrying live DB credentials — never commit.
/config.production.php
